{
  "name": "ms-classic-grind-tracker",
  "productName": "MS Classic Grind Tracker",
  "version": "0.1.0",
  "description": "Watches the MapleStory Classic World window while you grind: kills, EXP/hr, mesos/hr, drops. Reads pixels only.",
  "main": "app/main.js",
  "scripts": {
    "data": "node build_data.js",
    "test": "node tests/core.test.js",
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": { "electron-updater": "6.3.9" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "dev.turbosauce.msclassic.tracker",
    "files": ["app/**", "core/**", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true },
    "publish": { "provider": "github", "owner": "TurbosauceDev", "repo": "MS-Classic-World-Info-Slop", "releaseType": "release" }
  }
}
