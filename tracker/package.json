{
  "name": "ms-classic-grind-tracker",
  "productName": "MS Classic Grind Tracker",
  "version": "0.2.101",
  "description": "MS Classic Grind Tracker",
  "main": "app/main.js",
  "scripts": {
    "data": "node build_data.js",
    "test": "node tests/core.test.js && node tests/fuzz.test.js && node tests/cv.test.js && node tests/journal.test.js",
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "electron-updater": "6.3.9",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.turbosauce.msclassic.tracker",
    "files": [
      "app/**",
      "core/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": true
    },
    "publish": {
      "provider": "github",
      "owner": "TurbosauceDev",
      "repo": "MS-Classic-World-Info-Slop",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/{bmp-js,idb-keyval,is-url,node-fetch,opencollective-postinstall,regenerator-runtime,tr46,wasm-feature-detect,webidl-conversions,whatwg-url,zlibjs}/**"
    ]
  }
}
